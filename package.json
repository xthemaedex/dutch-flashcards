{
  "name": "dutch-flashcards",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Offline-first Dutch vocabulary flashcard PWA (fully static — no database)",
  "scripts": {
    "build": "python3 scripts/seed_db.py --json data/corpus_words.json --reset && python3 scripts/build_static.py --deploy",
    "dev": "python3 scripts/build_static.py && python3 scripts/serve.py"
  }
}
